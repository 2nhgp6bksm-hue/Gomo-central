{
  "name": "gomo-core-test",
  "main": "gomo-core-entry-v071.js",
  "compatibility_date": "2026-08-07",
  "compatibility_flags": ["nodejs_compat"],
  "build": {
    "command": "npm test && node --check gomo-core-entry-v07.js && node --check gomo-core-entry-v071.js"
  },
  "vars": {
    "GOMO_CORE_MODE": "test",
    "ALLIANCE_ABBR": "GoMo",
    "ALLIANCE_NAME": "God venoM",
    "ALLIANCE_ID": "26227dc9fb2945edaee8c7675c8fed5d",
    "SERVER_ID": "1591",
    "LASTRANK_URL": "https://www.lastrank.fun/a/26227dc9fb2945edaee8c7675c8fed5d",
    "LASTINTEL_MCP_URL": "https://mcp.lastintel.io/",
    "LASTINTEL_WEB_BASE": "https://lastintel.io/",
    "LASTINTEL_ALLIANCE_ID": "jzpvMwRRgPkPWtOgEraW9g",
    "LASTWARRANK_URL": "https://www.lastwarrank.com/alliance/MRMCVY2KTB",
    "CORE_PUBLIC_CACHE_SECONDS": "600",
    "CORE_CURRENT_READS": "1",
    "GOMO_ASSISTANT_PUBLIC_ORIGIN": "https://gomo-assistant-v2.gjp86wh7p2.workers.dev"
  },
  "d1_databases": [
    {
      "binding": "CORE_DB",
      "database_name": "gomo-core-d1-write-validation-105d61d-a3-db",
      "database_id": "bfb37928-febc-4ae6-8075-da89cc40d4d5"
    }
  ],
  "triggers": {
    "crons": ["15 * * * *"]
  },
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "run_worker_first": [
      "/",
      "/index.html",
      "/api/*",
      "/core",
      "/core/*",
      "/fallback.json",
      "/gestion-train",
      "/gestion-train/*",
      "/vs-planner",
      "/vs-planner/*",
      "/sw.js",
      "/shiny-radar",
      "/shiny-radar/*"
    ]
  },
  "services": [
    {
      "binding": "SHINY",
      "service": "gomo-shiny-central"
    },
    {
      "binding": "GOMO_ASSISTANT",
      "service": "gomo-assistant-v2"
    }
  ],
  "ai": {
    "binding": "AI"
  }
}
