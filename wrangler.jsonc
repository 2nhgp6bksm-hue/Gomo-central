{
  "name": "gomo-central-site",
  "main": "worker-v1.14.js",
  "compatibility_date": "2026-08-07",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "run_worker_first": [
      "/",
      "/index.html",
      "/api/*",
      "/fallback.json",
      "/assets/app-v1.5.js",
      "/assets/gomo-v19.js",
      "/icons/gomo-assistant.png",
      "/gestion-train",
      "/gestion-train/*",
      "/vs-planner",
      "/vs-planner/*",
      "/sw.js",
      "/shiny-radar",
      "/shiny-radar/*"
    ]
  },
  "services": [
    {
      "binding": "SHINY",
      "service": "gomo-shiny-central"
    }
  ],
  "ai": {
    "binding": "AI"
  }
}
