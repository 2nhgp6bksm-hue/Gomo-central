{
  "name": "gomo-central-site",
  "main": "worker-v1.11.js",
  "compatibility_date": "2026-08-07",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*",
      "/assets/app-v1.5.js"
    ]
  },
  "ai": {
    "binding": "AI"
  }
}
