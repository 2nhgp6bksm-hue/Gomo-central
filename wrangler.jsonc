{
  "name": "gomo-central-site",
  "main": "worker-v1.11.js",
  "compatibility_date": "2026-08-07",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "run_worker_first": [
      "/",
      "/index.html",
      "/api/*",
      "/fallback.json",
      "/assets/app-v1.5.js",
      "/assets/gomo-v19.js",
      "/vs-planner",
      "/vs-planner/*",
      "/sw.js",
      "/shiny-radar",
      "/shiny-radar/*"
    ]
  },
  "ai": {
    "binding": "AI"
  }
}
